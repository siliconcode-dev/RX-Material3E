{
  "name": "rx-material3e",
  "private": true,
  "description": "Material 3 and Material 3 Expressive as framework-free web components, ported by hand from Jetpack Compose Material3.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace @rx-m3e/web",
    "tokens:fetch": "node scripts/fetch-compose-source.mjs",
    "tokens": "node scripts/extract-compose-tokens.mjs .cache/androidx/compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/tokens \"$(git -C .cache/androidx rev-parse HEAD)\"",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.1.6",
    "vitest": "5.0.5"
  }
}
